<idea-plugin>
    <id>com.glowxq.plugs.oneclick</id>
    <name>OneClick</name>
    <vendor email="glowxq@qq.com" url="https://github.com/glowxq">glowxq</vendor>



    <description><![CDATA[
智能代码生成插件，一键生成JavaBean方法和枚举类parse方法。

核心亮点：
• JSON格式toString方法 - 符合阿里规范，无需JSON工具类，避免性能问题和异常风险
• 自动生成JSON格式toString，日志打印直接得到JSON格式，方便调试

核心功能：
• 智能一键生成 - 快捷键：Shift+Alt+D (Windows/Linux) / Cmd+Shift+D (Mac)
• JavaBean方法生成 - 自动生成 getter/setter/toString（JSON格式）
• 枚举类parse方法 - 自动生成根据code字段解析枚举的方法
• 变量名命名风格转换 - 循环切换4种命名风格
• DTO/VO/BO类生成 - 选中类名自动生成数据传输对象类

使用场景：
• 在Java类中按快捷键生成JavaBean方法（包含JSON格式toString）
• 在枚举类中按快捷键生成parse方法
• 选中变量名按快捷键循环切换命名风格
• 选中类名按快捷键生成DTO/VO/BO类

快速开始：
在Java类或枚举类中按 Shift+Alt+D (Windows/Linux) / Cmd+Shift+D (Mac)
    ]]></description>

    <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册设置面板 -->
        <applicationConfigurable
            parentId="tools"
            instance="com.glowxq.plugs.settings.OneClickSettingsConfigurable"
            id="OneClickSettings"
            displayName="OneClick Settings"/>

        <!-- 插件概览页面 -->
        <applicationConfigurable
            parentId="OneClickSettings"
            instance="com.glowxq.plugs.settings.PluginOverviewConfigurable"
            id="OneClickOverview"
            displayName="OneClick Overview"/>

        <!-- 注册快捷键设置面板 -->
        <applicationConfigurable
            parentId="OneClickSettings"
            instance="com.glowxq.plugs.settings.KeymapSettingsConfigurable"
            id="OneClickKeymapSettings"
            displayName="Keymap Settings"/>

        <!-- 通知组 -->
        <notificationGroup id="OneClick Plugin" displayType="BALLOON"/>

        <!-- 启动活动 -->
        <postStartupActivity implementation="com.glowxq.plugs.startup.OneClickStartupActivity"/>

        <!-- 注册设置服务 -->
        <applicationService serviceImplementation="com.glowxq.plugs.settings.OneClickSettings"/>
        <applicationService serviceImplementation="com.glowxq.plugs.settings.KeymapSettings"/>
    </extensions>

    <actions>
        <!-- 智能一键生成Action - 唯一保留的功能 -->
        <action id="com.glowxq.plugs.SmartOneClickAction"
                class="com.glowxq.plugs.actions.GenerateJavaBeanMethodsAction"
                text="🚀 Smart One-Click Generate"
                description="智能一键生成：JavaBean方法或枚举类parse方法">
            <!-- 添加到Generate菜单 -->
            <add-to-group group-id="GenerateGroup" anchor="first"/>
            <!-- 添加到右键菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Windows/Linux快捷键 -->
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift D"/>
            <!-- macOS快捷键 (meta = Cmd键, shift = Shift键) -->
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift D"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift D"/>
        </action>
    </actions>
</idea-plugin>
